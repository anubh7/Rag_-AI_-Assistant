# --- Server ---
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=
DEFAULT_COLLECTION=rag_documents

# --- Embeddings ---
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=768

# --- LLM ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_STRATEGY=recursive

# --- Retrieval ---
TOP_K=5
SCORE_THRESHOLD=0.5

# --- Uploads ---
UPLOAD_DIR=app/uploads
MAX_FILE_SIZE_MB=25

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=rag_assistant_db

# --- Security ---
JWT_SECRET_KEY=yoursupersecretkeyhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Local startup ---
# Set true only after the required spaCy model is installed.
PRESIDIO_ENABLED=false
